{
  "name": "@lcax/ui",
  "version": "0.0.1",
  "description": "UI Library for LCAx apps",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "type": "module",
  "dependencies": {
    "better-auth": "^1.6.9"
  },
  "peerDependencies": {
    "@apollo/client": "^4.1.6",
    "@fontsource/inter-tight": "^5.2.7",
    "@mantine/core": "^9.1.1",
    "@mantine/hooks": "^9.1.1",
    "@tabler/icons-react": "^3.40.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.10.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "tsc": "tsgo --noEmit",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format:fix": "oxfmt src/",
    "format": "oxfmt --check src/",
    "fix": "npm run lint:fix && npm run format:fix",
    "check": "npm run lint && npm run format && npm run tsc"
  },
  "author": "Christian Kongsgaard <christian@kongsgaard.eu>",
  "license": "MIT"
}
