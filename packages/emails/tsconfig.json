{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "dist"]
}
