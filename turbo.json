{
  "$schema": "https://turbo.build/schema.json",
  "futureFlags": { "globalConfiguration": true},
  "global": {
    "inputs": [".env"],
    "env": [
      "DATABASE_URL",
      "BASE_URL",
      "FRONTEND_URL",
      "BETTER_AUTH_SECRET",
      "VITE_BACKEND_URL",
      "VITE_DEV",
      "VITE_UMAMI_ID"
    ]
  },
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env"]
    },
    "check": {
      "dependsOn": ["tsc", "lint", "format"]
    },
    "tsc": {
      "dependsOn": ["^tsc"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "dev:search": {
      "with": ["@services/lcax#dev", "@lcax/search#dev", "@lcax/user-management#dev"],
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}